  <rect x="625" y="530" width="140" height="35" />
  <text x="695" y="552">Track Approval Status</text>
  <line x1="695" y1="565" x2="695" y2="595" marker-end="url(#arrow)" />
  <polygon points="695,595 755,620 695,645 635,620" />
  <text x="695" y="624">Print Slip?</text>
  <!-- Yes -> Print A4 Slip -->
  <line x1="695" y1="645" x2="695" y2="675" marker-end="url(#arrow)" />
  <text x="710" y="660">Yes</text>
  <rect x="625" y="675" width="140" height="35" />
  <text x="695" y="697">Print Loan Slip (A4)</text>
  <!-- No -> continue -->
  <line x1="635" y1="620" x2="610" y2="620" />
  <line x1="610" y1="620" x2="610" y2="730" />
  <line x1="610" y1="730" x2="695" y2="730" />
  <text x="620" y="612">No</text>
  <line x1="695" y1="710" x2="695" y2="830" />

  <!-- Convergence to Connector -->
  <line x1="125" y1="830" x2="695" y2="830" />
  <line x1="410" y1="830" x2="410" y2="860" marker-end="url(#arrow)" />
  <circle cx="410" cy="870" r="10" />
  <line x1="410" y1="880" x2="410" y2="915" marker-end="url(#arrow)" />

  <!-- Decision: Logout? -->
  <polygon points="410,915 490,950 410,985 330,950" />
  <text x="410" y="954">Logout?</text>

  <!-- No -> Back to Choose Activity -->
  <line x1="330" y1="950" x2="25" y2="950" />
  <line x1="25" y1="950" x2="25" y2="380" />
  <line x1="25" y1="380" x2="320" y2="380" marker-end="url(#arrow)" />
  <text x="175" y="942">No (Continue Browsing)</text>

  <!-- Yes -> End -->
  <line x1="410" y1="985" x2="410" y2="1025" marker-end="url(#arrow)" />
  <text x="425" y="1005">Yes</text>
  <ellipse cx="410" cy="1045" rx="50" ry="20" />
  <text x="410" y="1049" class="label">END</text>
</svg>

        <p class="figure-caption" style="margin-top: 15px;">Figure 3.111: Student Borrower Flowchart (Publication Black &amp; White Standard)</p>
