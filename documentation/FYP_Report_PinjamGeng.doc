  <line x1="360" y1="80" x2="560" y2="80" class="title-line" />
  <text x="370" y="98" class="pk">equipment_id (PK)</text>
  <text x="370" y="116">category_id (FK)</text>
  <text x="370" y="134">item_code</text>
  <text x="370" y="152">name</text>
  <text x="370" y="170">brand_model</text>
  <text x="370" y="188">total_qty</text>
